{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/entry.{client,server}.{js,jsx,ts,tsx}",
        "app/routes/**/*.{js,ts,tsx}",
        "tests/**/*.test.mjs",
      ],
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,css}"],
      "ignore": ["app/components/ui/*.{js,ts,tsx}", "public/sw.js"],
    },
    // The Cloud Functions: knip finds their entry from `main`.
    "functions": {
      "project": ["src/**/*.ts"],
    },
  },
  // `pnpm maintenance` (scripts/maintenance.mjs) runs the Google Cloud SDK
  // installed on the deployer's machine for a token; it isn't a package.
  "ignoreBinaries": ["gcloud"],
}
