rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(owner) {
      return owner == request.auth.uid;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegistered() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function canRead(readers) {
      return readers.hasAny([request.auth.uid])
    }

    function canWrite(writers) {
      return writers.hasAny([request.auth.uid])
    }

    // Shared documents (notes, tasks, finances, health logs) carry an `owner` and
    // `permissions.read` / `permissions.write` lists of user ids. Writers are
    // also readers.
    // People invited and not accepted yet are in `invites.read` /
    // `invites.write` (missing on items shared before invitations): they can
    // read the item, to see the invitation, and get access only by accepting.

    function invitedReaders(data) {
      return data.get('invites', {}).get('read', []);
    }

    function invitedWriters(data) {
      return data.get('invites', {}).get('write', []);
    }

    function canReadShared() {
      return canRead(resource.data.permissions.read)
        || canRead(invitedReaders(resource.data));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A new document belongs to its creator, who alone can read and write
    // it: anyone else is invited afterwards.
    function isValidNewShared() {
      let me = [request.auth.uid].toSet();
      return isRegistered()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.permissions.read.toSet() == me
        && request.resource.data.permissions.write.toSet() == me
        && !('invites' in request.resource.data);
    }

    // Someone newly invited must not have blocked the person inviting. The
    // app invites one person at a time, added at the end of `invites.read`,
    // so that is the one to check.
    function isInviteAllowed() {
      let after = invitedReaders(request.resource.data);
      let added = after.toSet().difference(invitedReaders(resource.data).toSet());
      return added.size() == 0
        || (
          added.size() == 1
            && added == [after[after.size() - 1]].toSet()
            && !exists(/databases/$(database)/documents/users/$(after[after.size() - 1])/blocked/$(request.auth.uid))
        );
    }

    // The owner may change anything, including inviting and roles, but not
    // the owner, and may not give anyone access directly: people get it by
    // accepting an invitation. A writer must already be a reader.
    function isOwnerUpdate() {
      let readersBefore = resource.data.permissions.read.toSet();
      return isOwner(resource.data.owner)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.permissions.read.toSet().difference(readersBefore).size() == 0
        && request.resource.data.permissions.write.toSet().difference(readersBefore).size() == 0
        && isInviteAllowed();
    }

    // Someone invited accepting: they join with exactly the access they were
    // offered, and their invitation goes; nothing else changes.
    function isAcceptUpdate() {
      let me = [request.auth.uid].toSet();
      let before = resource.data;
      let after = request.resource.data;
      let writersAfter = invitedWriters(before).hasAny([request.auth.uid])
        ? before.permissions.write.toSet().union(me)
        : before.permissions.write.toSet();
      return canRead(invitedReaders(before))
        && !canRead(before.permissions.read)
        && changedKeys().hasOnly(['permissions', 'invites'])
        && after.permissions.read.toSet() == before.permissions.read.toSet().union(me)
        && after.permissions.write.toSet() == writersAfter
        && invitedReaders(after).toSet() == invitedReaders(before).toSet().difference(me)
        && invitedWriters(after).toSet() == invitedWriters(before).toSet().difference(me);
    }

    // Someone invited declining: their invitation (and the key sealed for it
    // on an encrypted item) goes, and nothing else.
    function isDeclineUpdate() {
      let me = [request.auth.uid].toSet();
      return canRead(invitedReaders(resource.data))
        && changedKeys().hasOnly(['invites', 'keys'])
        && (
          !('keys' in resource.data)
            || resource.data.keys.diff(request.resource.data.get('keys', {})).affectedKeys().hasOnly([request.auth.uid])
        )
        && invitedReaders(request.resource.data).toSet() == invitedReaders(resource.data).toSet().difference(me)
        && invitedWriters(request.resource.data).toSet() == invitedWriters(resource.data).toSet().difference(me);
    }

    // Writers may change the content fields only. An encrypted item's content
    // is its `encrypted` blob: nothing plain may be written into it, so an
    // older app can't overwrite it with readable text.
    function isContentUpdate(contentKeys) {
      return canWrite(resource.data.permissions.write)
        && (
          'encrypted' in resource.data
            ? changedKeys().hasOnly(['encrypted', 'updatedAt'])
            : changedKeys().hasOnly(contentKeys.concat(['updatedAt']))
        );
    }

    // Anyone with access may pin or archive it (`pinnedBy`, `archivedBy`)
    // for themselves only: one list per update, changing only their own id.
    function isOwnListUpdate(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return canRead(resource.data.permissions.read)
        && changedKeys().hasOnly([field])
        && before.difference(after).union(after.difference(before)).hasOnly([request.auth.uid]);
    }

    // Someone it is shared with may remove themselves (and their sealed key
    // of an encrypted item), and nobody else.
    function isLeaveUpdate() {
      let me = [request.auth.uid].toSet();
      return canRead(resource.data.permissions.read)
        && !isOwner(resource.data.owner)
        && changedKeys().hasOnly(['permissions', 'keys'])
        && (
          !('keys' in resource.data)
            || resource.data.keys.diff(request.resource.data.get('keys', {})).affectedKeys().hasOnly([request.auth.uid])
        )
        && request.resource.data.permissions.read.toSet() == resource.data.permissions.read.toSet().difference(me)
        && request.resource.data.permissions.write.toSet() == resource.data.permissions.write.toSet().difference(me);
    }

    function canUpdateShared(contentKeys) {
      return isOwnerUpdate()
        || isContentUpdate(contentKeys)
        || isOwnListUpdate('pinnedBy')
        || isOwnListUpdate('archivedBy')
        || isLeaveUpdate()
        || isAcceptUpdate()
        || isDeclineUpdate();
    }

    // Profiles are read one at a time, by id (the people an item is shared
    // with); they can't be listed, so nobody can download everyone's email.
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow write: if isOwner(userId);

      match /currencies/{currencyId} {
        allow read, write: if isOwner(userId);
      }

      // The sealed private key (end-to-end encryption): its owner only.
      match /keys/{keyId} {
        allow read, write: if isOwner(userId);
      }

      // People the person blocked: their own private list, so nobody can see
      // who blocked them. Invitations from them are refused (`isOwnerUpdate`).
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // The devices that get push notifications: one push token each, in
      // the language its notifications are written in. Only its owner (and
      // the functions that send the notifications) read them.
      match /pushTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'lang', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.lang in ['en', 'id']
          && request.resource.data.updatedAt is timestamp;
      }

      // Each device's public key for sealed push text, under the same id as
      // its token. Anyone signed in may read them, to seal a notification
      // for that person; only the owner writes them.
      match /pushKeys/{tokenId} {
        allow read: if isAuthenticated();
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['publicKey', 'lang', 'updatedAt'])
          && request.resource.data.publicKey is string
          && request.resource.data.publicKey.size() > 0
          && request.resource.data.publicKey.size() <= 200
          && request.resource.data.get('lang', 'en') in ['en', 'id']
          && request.resource.data.updatedAt is timestamp;
      }
    }

    // Push notifications waiting to be sent, read and deleted only by the
    // Cloud Function that sends them. An invitation's goes in the same
    // batch as the invitation: the item's owner adds `to` to its invites
    // there, so nobody can push to someone they aren't inviting.
    // `sealed` holds text sealed for each of the recipient's devices.
    function isNewInvite(message) {
      let path = /databases/$(database)/documents/$(message.collection)/$(message.item);
      let before = get(path).data;
      let after = getAfter(path).data;
      return isOwner(after.owner)
        && invitedReaders(after).hasAny([message.to])
        && !invitedReaders(before).hasAny([message.to])
        && !before.permissions.read.hasAny([message.to]);
    }

    match /pushMessages/{messageId} {
      allow create: if isRegistered()
        && request.resource.data.keys().hasOnly(['kind', 'to', 'from', 'collection', 'item', 'sealed', 'createdAt'])
        && request.resource.data.kind == 'invitation'
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.collection in ['notes', 'tasks', 'finances', 'healthLogs']
        && request.resource.data.item is string
        && request.resource.data.sealed is map
        && request.resource.data.sealed.size() <= 20
        && request.resource.data.createdAt == request.time
        && isNewInvite(request.resource.data);
    }

    // Finding someone by email to share with: `userLookup/{email}` holds
    // their id. Read one entry at a time, never listed. Each person files
    // only the email they are signed in with, pointing at themselves.
    match /userLookup/{email} {
      allow get: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // App-wide settings set from the Firebase console, such as maintenance
    // mode (`config/app`): everyone reads them, even signed out, so the
    // sign-in pages can show it too; the app never writes them.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /notes/{noteId} {
      allow read: if canReadShared();
      allow create: if isValidNewShared();
      allow update: if canUpdateShared(['title', 'content', 'cardStyle', 'encrypted']);
      allow delete: if isOwner(resource.data.owner);
    }

    match /tasks/{taskId} {
      allow read: if canReadShared();
      allow create: if isValidNewShared();
      allow update: if canUpdateShared(['title', 'content', 'cardStyle', 'encrypted']);
      allow delete: if isOwner(resource.data.owner);
    }

    // A book's entries are in one document per month under it (`months`),
    // never in the book: it has `entryStore` 2 and no `content`, always.
    function isMonthsBook(data) {
      return data.get('entryStore', 0) == 2 && !('content' in data);
    }

    match /finances/{financeId} {
      allow read: if canReadShared();
      allow create: if isValidNewShared() && isMonthsBook(request.resource.data);
      allow update: if isMonthsBook(request.resource.data)
        && canUpdateShared(['title', 'currency', 'accounts', 'summary', 'cardStyle', 'encrypted']);
      allow delete: if isOwner(resource.data.owner);

      // A month of a moved book's entries. Read by its readers (not by people
      // only invited) and written by its writers, in the book's mode: plain
      // (`month` "YYYY-MM", the id, and its `content`) or encrypted (one
      // `encrypted` blob; the id is derived from the book's key, so the month
      // isn't readable). The book is checked as it is after the write, so a
      // book and its months can change together (moving, encrypting,
      // re-keying).
      match /months/{monthId} {
        function book() {
          return get(/databases/$(database)/documents/finances/$(financeId)).data;
        }

        function bookAfter() {
          return getAfter(/databases/$(database)/documents/finances/$(financeId)).data;
        }

        function isValidMonth(book) {
          let data = request.resource.data;
          return isMonthsBook(book)
            && (
              'encrypted' in book
                ? data.keys().hasOnly(['encrypted'])
                  && data.encrypted.keys().hasOnly(['v', 'iv', 'ct'])
                  && data.encrypted.ct is string
                : data.keys().hasOnly(['month', 'content'])
                  && data.month == monthId
                  && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                  && data.content is list
            );
        }

        allow read: if canRead(book().permissions.read);
        allow create, update: if canWrite(bookAfter().permissions.write)
          && isValidMonth(bookAfter());
        allow delete: if canWrite(book().permissions.write);
      }
    }

    // Health logs: one person's measurements, shared like the others.
    match /healthLogs/{healthLogId} {
      allow read: if canReadShared();
      allow create: if isValidNewShared();
      allow update: if canUpdateShared(['name', 'birthDate', 'sex', 'calorieTarget', 'content', 'reminders', 'medications', 'doseLog', 'cardStyle', 'encrypted']);
      allow delete: if isOwner(resource.data.owner);

      // When a reminder's or a medicine's push notifications go out, one
      // document per reminder: its upcoming times (`next` is the first, for
      // the Cloud Function that sends them) and its text sealed for each
      // device of the people with access. Kept by the people who can edit
      // the log, as their app works out the times from its content.
      match /pushSchedule/{reminderId} {
        function canSchedule() {
          let log = get(/databases/$(database)/documents/healthLogs/$(healthLogId)).data;
          return isAuthenticated()
            && (log.owner == request.auth.uid
              || canWrite(log.get('permissions', {}).get('write', [])));
        }

        allow read, delete: if canSchedule();
        allow create, update: if canSchedule()
          && request.resource.data.keys().hasOnly(['kind', 'ownerOnly', 'times', 'next', 'sealed', 'updatedAt'])
          && request.resource.data.kind in ['medicine', 'reminder']
          && request.resource.data.get('ownerOnly', false) is bool
          && request.resource.data.times is list
          && request.resource.data.times.size() > 0
          && request.resource.data.times.size() <= 64
          && request.resource.data.next is timestamp
          && request.resource.data.next == request.resource.data.times[0]
          && request.resource.data.sealed is map
          && request.resource.data.sealed.size() <= 50
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
